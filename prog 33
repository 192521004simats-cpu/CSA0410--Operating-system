#include <stdio.h>
#include <stdlib.h>

void sort(int arr[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

void cscan_disk_scheduling(int requests[], int n, int head, int disk_size) {
    int total_seek_count = 0;
    int current_track = head;

    int size = n + 3;
    int *arr = (int*)malloc(size * sizeof(int));
    
    for (int i = 0; i < n; i++) arr[i] = requests[i];
    arr[n] = head;
    arr[n + 1] = 0;
    arr[n + 2] = disk_size - 1;

    sort(arr, size);

    int head_idx = 0;
    for (int i = 0; i < size; i++) {
        if (arr[i] == head) {
            head_idx = i;
            break;
        }
    }

    printf("\nC-SCAN Execution Path:\n%d", head);

    for (int i = head_idx + 1; i < size; i++) {
        printf(" -> %d", arr[i]);
        total_seek_count += abs(arr[i] - current_track);
        current_track = arr[i];
    }

    printf(" -> %d", 0);
    total_seek_count += abs(0 - current_track);
    current_track = 0;

    for (int i = 1; i < head_idx; i++) {
        printf(" -> %d", arr[i]);
        total_seek_count += abs(arr[i] - current_track);
        current_track = arr[i];
    }

    printf("\n\nTotal Seek Operations Count: %d\n", total_seek_count);
    free(arr);
}

int main() {
    int requests[] = {98, 183, 37, 122, 14, 124, 65, 67};
    int n = sizeof(requests) / sizeof(requests[0]);
    int head = 53;
    int disk_size = 200;

    cscan_disk_scheduling(requests, n, head, disk_size);
    return 0;
}
