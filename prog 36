#include <stdio.h>

int main() {
    FILE *fp;
    char data[100];

    /* Create and write */
    fp = fopen("file.txt", "w");

    printf("Enter data: ");
    scanf(" %[^\n]", data);

    fprintf(fp, "%s", data);
    fclose(fp);

    /* Read */
    fp = fopen("file.txt", "r");

    printf("\nFile contents:\n");
    while(fgets(data, sizeof(data), fp))
        printf("%s\n", data);

    fclose(fp);

    /* Append */
    fp = fopen("file.txt", "a");
    fprintf(fp, "\nNew data added.");
    fclose(fp);

    printf("\nFile created, read and updated successfully.\n");

    return 0;
}
